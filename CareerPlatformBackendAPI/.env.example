# Environment configuration for CareerPlatformBackendAPI

# SQLite database URL (async)
# For production deployments, ensure the data directory is writable by the app process.
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Optional metadata
APP_NAME="MVP Career Platform Backend"
APP_VERSION="1.0.0"

# Note:
# Previous PostgreSQL environment variables (e.g., POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB, DATABASE_URL with postgresql scheme)
# are no longer used after migration to SQLite.
