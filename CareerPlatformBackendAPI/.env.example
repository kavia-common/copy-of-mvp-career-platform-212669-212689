# Copy this file to .env and adjust as needed

# Application
APP_NAME="MVP Career Platform Backend"
APP_VERSION="1.0.0"

# Database (SQLite with aiosqlite)
# Use a local file DB by default
DATABASE_URL="sqlite+aiosqlite:///./data/app.db"

# Seeding helper (optional)
ALLOW_SEED_ENDPOINT=true

# JWT Auth
# IMPORTANT: Change this secret for any deployed environment
JWT_SECRET="please-change-me"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES="60"
JWT_ISSUER="career-platform"
