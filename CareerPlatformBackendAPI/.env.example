# Backend environment example
# Copy to .env and adjust as needed. Do not commit real secrets.

# Optional: enable seed endpoints for quick verification
ALLOW_SEED_ENDPOINT=true

# Optional: override default SQLite path (defaults to ./data/app.db using aiosqlite)
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# JWT configuration (MVP: HS256)
JWT_SECRET=dev-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_ISSUER=career-platform

# Integration: Node Role Mapping Service
# Base URL for the Node service (default: http://localhost:4001)
ROLE_MAPPER_BASE_URL=http://localhost:4001
# Internal token used for backend->Node auth via X-Internal-Token
INTERNAL_TOKEN=dev-internal-token
