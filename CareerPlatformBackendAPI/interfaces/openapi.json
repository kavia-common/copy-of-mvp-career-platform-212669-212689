        "summary": "Get user by ID",
        "description": "Retrieve a user by ID.\n\nArgs:\n    user_id: UUID string identifier for the user.\n    session: Async database session.\n\nReturns:\n    The matching User.\n\nRaises:\n    HTTPException 404 if not found.",
        "operationId": "get_user_api_v1_users__user_id__get",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "User Id"
