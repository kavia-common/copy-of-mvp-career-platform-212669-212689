{
  "openapi": "3.1.0",
  "info": {
    "title": "MVP Career Platform Backend",
    "description": "Central backend service for the MVP Career Platform. Uses PostgreSQL (async via asyncpg) if configured via env; falls back to SQLite (aiosqlite) otherwise.",
    "version": "1.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health Check",
        "description": "Simple health check endpoint returning a basic status message.",
        "operationId": "health_check__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Check  Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Create a user",
        "description": "Create a new user.\n\nThis endpoint demonstrates write operations on SQLite via SQLAlchemy (async).\nApplication-side uniqueness is enforced to avoid relying on ON CONFLICT specifics.\n\nArgs:\n    payload: UserCreate schema containing email, name, and roles.\n    session: Async database session.\n\nReturns:\n    The created User.",
        "operationId": "create_user_api_v1_users_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRead"
                }
              }
            }
          },
          "409": {
            "description": "A user with this email already exists"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "List users",
        "description": "Retrieve users, optionally filtering by a case-insensitive query string.\n\nUses lower() LIKE instead of ILIKE for portability to SQLite.\n\nArgs:\n    q: Optional case-insensitive search term.\n    session: Async database session.\n\nReturns:\n    A list of User objects.",
        "operationId": "list_users_api_v1_users_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional case-insensitive search on email or name",
              "title": "Q"
            },
            "description": "Optional case-insensitive search on email or name"
          }
        ],
        "responses": {
          "200": {
            "description": "List of users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserRead"
                  },
                  "title": "Response List Users Api V1 Users Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/{user_id}": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get user by ID",
        "description": "Retrieve a user by ID.\n\nArgs:\n    user_id: UUID string identifier for the user.\n    session: Async database session.\n\nReturns:\n    The matching User.\n\nRaises:\n    HTTPException 404 if not found.",
        "operationId": "get_user_api_v1_users__user_id__get",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "User Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRead"
                }
              }
            }
          },
          "404": {
            "description": "User not found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/roles": {
      "post": {
        "tags": [
          "Roles"
        ],
        "summary": "Create a role",
        "description": "Create a new role record in the database.",
        "operationId": "create_role_api_v1_roles_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoleCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Role created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoleRead"
                }
              }
            }
          },
          "409": {
            "description": "A role with this id already exists"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Roles"
        ],
        "summary": "List roles",
        "description": "Retrieve all roles, with optional case-insensitive filtering on name/description.",
        "operationId": "list_roles_api_v1_roles_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional case-insensitive search on name or description",
              "title": "Q"
            },
            "description": "Optional case-insensitive search on name or description"
          }
        ],
        "responses": {
          "200": {
            "description": "List of roles",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RoleRead"
                  },
                  "title": "Response List Roles Api V1 Roles Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/roles/seed": {
      "post": {
        "tags": [
          "Roles"
        ],
        "summary": "Seed a sample role",
        "description": "Insert a sample role for verification. Guarded by ALLOW_SEED_ENDPOINT=true.",
        "operationId": "seed_role_api_v1_roles_seed_post",
        "responses": {
          "200": {
            "description": "Seeded (or existing) role returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoleRead"
                }
              }
            }
          },
          "403": {
            "description": "Seeding is disabled"
          }
        }
      }
    }
  },
